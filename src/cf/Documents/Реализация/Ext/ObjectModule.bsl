#Область Логика

Процедура ОбработкаПроведения(Отказ, Режим)
	// При перепроведении старые движения ещё лежат в регистре — очищаем их до проверки остатков.
	// Если проведение не пройдёт, транзакция откатится и старые движения вернутся.
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Записать();
	
	// Сначала проверяем остатки: расход без проверки уводит склад в минус.
	ПроверитьОстаткиТоваров(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Каждая строка табличной части — расход товара со склада на дату документа.
	Движения.ОстаткиТоваров.Записывать = Истина;
	Для Каждого ТекущаяСтрокаТоваров Из Товары Цикл
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекущаяСтрокаТоваров.Товар;
		Движение.Количество = ТекущаяСтрокаТоваров.Количество;
	КонецЦикла;
	
	// Каждая строка табличной части — продажа товара контрагенту на дату документа.
	Движения.Продажи.Записывать = Истина;
	Для Каждого ТекущаяСтрокаТоваров Из Товары Цикл
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Товар = ТекущаяСтрокаТоваров.Товар;
		Движение.Контрагент = Контрагент;
		Движение.Количество = ТекущаяСтрокаТоваров.Количество;
		Движение.Сумма = ТекущаяСтрокаТоваров.Сумма;
	КонецЦикла;
КонецПроцедуры

// Сравнивает количество каждого товара документа с остатком на момент документа.
// Граница «Исключая» отбрасывает движения в момент документа и позже; свои старые движения уже очищены выше.
Процедура ПроверитьОстаткиТоваров(Отказ)
	
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст =
	"ВЫБРАТЬ
	|	ТоварыДокумента.Товар КАК Товар,
	|	ТоварыДокумента.Количество КАК Количество,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		Строки.Товар КАК Товар,
	|		СУММА(Строки.Количество) КАК Количество
	|	ИЗ
	|		Документ.Реализация.Товары КАК Строки
	|	ГДЕ
	|		Строки.Ссылка = &Ссылка
	|	СГРУППИРОВАТЬ ПО
	|		Строки.Товар) КАК ТоварыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&Граница,
	|				Товар В
	|					(ВЫБРАТЬ
	|						Строки.Товар
	|					ИЗ
	|						Документ.Реализация.Товары КАК Строки
	|					ГДЕ
	|						Строки.Ссылка = &Ссылка)) КАК Остатки
	|		ПО ТоварыДокумента.Товар = Остатки.Товар
	|ГДЕ
	|	ТоварыДокумента.Количество > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)";
	ЗапросОстатков.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросОстатков.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	
	ВыборкаНехватки = ЗапросОстатков.Выполнить().Выбрать();
	Пока ВыборкаНехватки.Следующий() Цикл
		СообщениеОНехватке = Новый СообщениеПользователю;
		СообщениеОНехватке.Текст = СтрШаблон("Недостаточно товара «%1»: нужно %2, на складе %3.",
		ВыборкаНехватки.Товар, ВыборкаНехватки.Количество, ВыборкаНехватки.Остаток);
		СообщениеОНехватке.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
