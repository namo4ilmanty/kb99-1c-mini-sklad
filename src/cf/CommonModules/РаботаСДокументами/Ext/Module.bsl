#Область Логика

// Пересчитывает сумму строки табличной части «Товары»: количество × цена.
// Вынесено в общий модуль, чтобы формы Поступления и Реализации считали одинаково.
//
// Параметры:
//  СтрокаТоваров - ДанныеФормыЭлементКоллекции - текущая строка табличной части Товары.
//
Процедура РассчитатьСумму(СтрокаТоваров) Экспорт

	// Текущей строки нет, если пользователь ещё не выбрал строку.
	// ЗначениеЗаполнено здесь не подходит: строка таблицы формы — мутабельный объект.
	Если СтрокаТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;

КонецПроцедуры

#КонецОбласти
